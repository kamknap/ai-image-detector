# Copy this file to ".env" and adjust values for local development.

# Base URL of the detection backend. Leave EMPTY to use the built-in mock.
# Example for a real backend: VITE_API_URL=https://my-backend.azurewebsites.net
VITE_API_URL=

# Force the mock even if VITE_API_URL is set ("true" / "false").
VITE_USE_MOCK=true
